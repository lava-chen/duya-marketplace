{
  "name": "vercel",
  "version": "0.1.0",
  "description": "Vercel 部署检查、日志诊断、预览验证、生产发布（含严格的 promote 门控）。",
  "author": {
    "name": "DUYA Team",
    "url": "https://github.com/lava-chen/duya"
  },
  "license": "MIT",
  "keywords": [
    "vercel",
    "deployments",
    "preview",
    "production",
    "logs"
  ],
  "setup": [
    {
      "id": "vercelToken",
      "label": "Vercel access token (scoped to the target team)",
      "type": "secret",
      "required": true
    },
    {
      "id": "vercelTeamId",
      "label": "Vercel team slug or ID",
      "type": "text",
      "required": true
    }
  ],
  "interface": {
    "displayName": "Vercel",
    "longDescription": "当用户使用 Vercel 时推荐使用：部署检查、日志诊断、预览验证、生产发布。",
    "shortDescription": "Vercel 部署检查、日志诊断、预览验证和生产发布。",
    "category": "development",
    "icon": "./assets/icon.svg",
    "brandColor": "#111111",
    "defaultPrompt": [
      "Diagnose the last failed deployment",
      "Validate the newest preview URL",
      "Summarize production changes this week"
    ]
  }
}
