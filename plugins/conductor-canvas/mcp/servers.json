{
  "servers": [
    {
      "name": "conductor_canvas",
      "command": "node",
      "args": [
        "${DUYA_PLUGIN_ROOT}/server.cjs"
      ],
      "env": {
        "DUYA_CANVAS_STORE": "${DUYA_PLUGIN_DATA}/canvases.json",
        "CANVAS_OPENAI_BASE_URL": "${CANVAS_OPENAI_BASE_URL:-}",
        "CANVAS_OPENAI_MODEL": "${CANVAS_OPENAI_MODEL:-}",
        "CANVAS_OPENAI_API_KEY": "${CANVAS_OPENAI_API_KEY:-}"
      },
      "envPassthrough": "allowlist",
      "startupTimeoutSec": 15,
      "toolTimeoutSec": 90
    },
    {
      "name": "conductor_canvas_snapshot",
      "command": "node",
      "args": [
        "${DUYA_PLUGIN_ROOT}/link-snapshot-server.cjs"
      ],
      "env": {
        "DUYA_CANVAS_STORE": "${DUYA_PLUGIN_DATA}/canvases.json",
        "CHROME_BIN": "${CHROME_BIN:-}",
        "DUYA_BROWSER_EXECUTABLE": "${DUYA_BROWSER_EXECUTABLE:-}",
        "DISPLAY": "${DISPLAY:-}",
        "WAYLAND_DISPLAY": "${WAYLAND_DISPLAY:-}",
        "XDG_RUNTIME_DIR": "${XDG_RUNTIME_DIR:-}"
      },
      "envPassthrough": "allowlist",
      "startupTimeoutSec": 15,
      "toolTimeoutSec": 90
    }
  ]
}
