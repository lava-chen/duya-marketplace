{
  "name": "conductor-canvas",
  "id": "com.duya.conductor-canvas",
  "version": "0.4.0",
  "description": "A self-contained Conductor-style visual workspace with an installable Mini App and MCP editing tools.",
  "author": { "name": "DUYA Team", "url": "https://github.com/lava-chen/duya" },
  "license": "MIT",
  "keywords": ["conductor", "canvas", "mini-app"],
  "interface": {
    "displayName": "Conductor Canvas",
    "shortDescription": "Open and inspect the active Conductor canvas.",
    "category": "productivity",
    "icon": "./assets/icon.svg",
    "displayName_zh": "Conductor 画布",
    "shortDescription_zh": "打开并查看当前 Conductor 画布。"
  },
  "extensions": {
    "com.duya.client": {
      "apps": [
        {
          "appId": "canvas",
          "entry": "apps/canvas/build/index.html",
          "runtime": "standalone",
          "requiredCapabilities": ["conductor.canvas"],
          "capabilityTools": [{
            "capability": "conductor.canvas",
            "tools": [
              { "serverName": "conductor_canvas", "toolName": "canvas_manage" },
              { "serverName": "conductor_canvas", "toolName": "canvas_create" },
              { "serverName": "conductor_canvas", "toolName": "canvas_rename" },
              { "serverName": "conductor_canvas", "toolName": "canvas_delete" },
              { "serverName": "conductor_canvas", "toolName": "canvas_update_metadata" },
              { "serverName": "conductor_canvas", "toolName": "canvas_group_list" },
              { "serverName": "conductor_canvas", "toolName": "canvas_group_create" },
              { "serverName": "conductor_canvas", "toolName": "canvas_group_rename" },
              { "serverName": "conductor_canvas", "toolName": "canvas_group_delete" },
              { "serverName": "conductor_canvas", "toolName": "canvas_get_snapshot" },
              { "serverName": "conductor_canvas", "toolName": "canvas_execute_action" },
              { "serverName": "conductor_canvas", "toolName": "canvas_project_database" },
              { "serverName": "conductor_canvas", "toolName": "canvas_update" },
              { "serverName": "conductor_canvas", "toolName": "canvas_export" },
              { "serverName": "conductor_canvas", "toolName": "canvas_import" },
              { "serverName": "conductor_canvas", "toolName": "canvas_import_bundle" },
              { "serverName": "conductor_canvas", "toolName": "canvas_asset_put" },
              { "serverName": "conductor_canvas", "toolName": "canvas_asset_get" },
              { "serverName": "conductor_canvas", "toolName": "canvas_list_elements" },
              { "serverName": "conductor_canvas", "toolName": "canvas_create_element" },
              { "serverName": "conductor_canvas", "toolName": "canvas_connect_elements" },
              { "serverName": "conductor_canvas", "toolName": "canvas_group_elements" },
              { "serverName": "conductor_canvas", "toolName": "canvas_ungroup_elements" },
              { "serverName": "conductor_canvas", "toolName": "canvas_move_element" },
              { "serverName": "conductor_canvas", "toolName": "canvas_resize_element" },
              { "serverName": "conductor_canvas", "toolName": "canvas_fill_content" },
              { "serverName": "conductor_canvas", "toolName": "canvas_style_element" },
              { "serverName": "conductor_canvas", "toolName": "canvas_delete_element" },
              { "serverName": "conductor_canvas", "toolName": "canvas_undo" },
              { "serverName": "conductor_canvas", "toolName": "canvas_redo" },
              { "serverName": "conductor_canvas", "toolName": "canvas_find_empty_space" },
              { "serverName": "conductor_canvas", "toolName": "canvas_auto_layout" },
              { "serverName": "conductor_canvas", "toolName": "canvas_apply_layout" },
              { "serverName": "conductor_canvas", "toolName": "canvas_get_knowledge" }
            ]
          }],
          "stateSchemaVersion": 1
        }
      ]
    }
  }
}
